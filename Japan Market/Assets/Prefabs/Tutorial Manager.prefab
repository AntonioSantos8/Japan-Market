--- !u!114 &7250432448065081678
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7187480845623899683}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fcb8a97fd60b0fa4686fd4b68bf6fbb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  mascotController: {fileID: 2451364668924045033}
  steps:
  - stepId: Welcome
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: bem vindo ao esse jogo aqui meus amigos
      extraWaitAfterLine: 2
    - text: "Quantas vezes sao necessarias\t\t"
      extraWaitAfterLine: 2
    - text: Quantas quiser
      extraWaitAfterLine: 2
    - text: bla bla bla
      extraWaitAfterLine: 2
    - text: ...
      extraWaitAfterLine: 2
    - text: Agora, caminhe entre na loja para prosseguir
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: EnteredStore
    delayBeforeNextStep: 2
  - stepId: EnteredStore
    mascotTargetPosition: {fileID: 6583276306721906135}
    textBoxTargetPosition: {fileID: 3052205687286627385}
    dialogueLines:
    - text: ACabou de entrar na loja
      extraWaitAfterLine: 1
    - text: "agora caminhe em dire\xE7\xE3o ao computador"
      extraWaitAfterLine: 2
    - text: e use
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: EnteredComputer
    delayBeforeNextStep: 1
  - stepId: EnteredComputer
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Agora que entrou no pc, use [A] e [D] para navegar e [ENTER] para selecionar.
      extraWaitAfterLine: 3
    - text: "use o dinheiro que voc\xEA tem para comprar uma prateleira e um produto
        para vender."
      extraWaitAfterLine: 3
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: BoughtFurnitureAndFood
    delayBeforeNextStep: 1
  - stepId: BoughtFurnitureAndFood
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "Voc\xEA comprou o que precisava\t\t\t"
      extraWaitAfterLine: 2
    - text: Agora pegue a caixa com icone de prateleira e coloque no interior da
        loja
      extraWaitAfterLine: 3
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: HasPutFurniture
    delayBeforeNextStep: 1
  - stepId: HasPutFurniture
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "Voc\xEA gostou do lugar em que a pratelria foi colocada? caso n\xE3o,
        pressione B para entrar no modo de constru\xE7\xE3o e segure o bot\xE3o direito
        do mouse na prateleira para muda-la de posi\xE7\xE3o."
      extraWaitAfterLine: 3
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: HasMovedFurniture
    delayBeforeNextStep: 1
  - stepId: HasMovedFurniture
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "J\xE1 que moveu a furniture, agora, pegue a caixa e coloque na prateleira,
        no segmento que desejar"
      extraWaitAfterLine: 3
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: HasPutFood
    delayBeforeNextStep: 1
  - stepId: HasPutFood
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "Esse UI que apareceu na sua tela indica o pre\xE7o que o produto est\xE1
        no mercado global e no seu."
      extraWaitAfterLine: 2
    - text: "para mudar, clique no pre\xE7o de mercado e digite o novo valor."
      extraWaitAfterLine: 2
    - text: "mas cuidado, se estiver muito caro os clientes poder\xE3o n\xE3o gostar."
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: HasPutPrice
    delayBeforeNextStep: 1
  - stepId: HasPutPrice
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Agora, se aproxime da placa de abrir e abra a loja.
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: StoreOpened
    delayBeforeNextStep: 1
  - stepId: StoreOpened
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "Parab\xE9ns, a sua loja est\xE1 aberta."
      extraWaitAfterLine: 1
    - text: Espere por clientes
      extraWaitAfterLine: 1
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: ClientCame
    delayBeforeNextStep: 1
  - stepId: ClientCame
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: "Olhe, um cliente est\xE1 vindo"
      extraWaitAfterLine: 2
    - text: Espere ele escolher os produtos q ele quer
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: ClientOnCashRegister
    delayBeforeNextStep: 1
  - stepId: ClientOnCashRegister
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Cliente chegou na caixa registradore
      extraWaitAfterLine: 2
    - text: Interaja com a bancada
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: EnteredCashRegister
    delayBeforeNextStep: 1
  - stepId: EnteredCashRegister
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Entrou na caixa registradora, clique para passar os produtor
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: PassedAllProducts
    delayBeforeNextStep: 1
  - stepId: PassedAllProducts
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Clique para escolher a forma de pagamento
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: ChoosedPaymentType
    delayBeforeNextStep: 1
  - stepId: ChoosedPaymentType
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: Conclua a compra dando o troco ou inserido o valor que o cliente deve
        receber de troco
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 2
    requiredEventId: FinishedTutorial
    delayBeforeNextStep: 1
  - stepId: FinishedTutorial
    mascotTargetPosition: {fileID: 4938137836108460407}
    textBoxTargetPosition: {fileID: 3217876424232810313}
    dialogueLines:
    - text: temino tutoria
      extraWaitAfterLine: 2
    onMascotStartTalking:
      m_PersistentCalls:
        m_Calls: []
    timePerLetterOverride: 0
    completionMode: 0
    requiredEventId: 
    delayBeforeNextStep: 1
  startAutomatically: 1
